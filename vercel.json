{
  "redirects": [
    {
      "source": "/",
      "destination": "/frontend/home.html.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sistema-geral-copal.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://sistema-geral-copal.onrender.com/auth/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sistema-geral-copal.onrender.com/uploads/:path*"
    }
  ]
}