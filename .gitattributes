# Normalize line endings to CRLF for Windows development
* text=auto eol=crlf

# Keep shell scripts with LF when needed
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.sqlite binary
*.db binary
*.sqlite3 binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.webp binary
